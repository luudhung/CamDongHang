{
  "name": "camdonghang-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare:studio": "esbuild src/studio/bridge.ts --bundle --minify --format=iife --target=es2022 --outfile=public/studio/bridge.js",
    "dev": "npm run prepare:studio && next dev",
    "build": "npm run prepare:studio && next build",
