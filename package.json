  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "idb": "8.0.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.9.3"
  }
}
